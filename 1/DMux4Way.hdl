/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    DMux(in = in, sel = sel[0], a=tempA, b=tempB);
    DMux(in = in, sel = sel[0], a=tempC, b=tempD);
    // 00, tempA = in, tempB = 0, tempC = in, tempD = 0
    // 01, tempA = 0, tempB = in, tempC = 0, tempD = in
    // 10, tempA = in, tempB = 0, tempC = in, tempD = 0
    // 11, tempA = 0, tempB = in, tempC = 0, tempD = in
    // E.g. 00. We then need to set tempC to 0
    // Since sel[1] == 0, set c to 0
    // If tempA is in but sel[1] == 1, set a to 0
    // Set a to 0 if sel[1] is not zero
    DMux(in = in, sel = sel[1], a=a, b=c);
    DMux(in = in, sel = sel[1], a=b, b=d);
    //And(a=tempA, b=tempC, out=
    //DMux(in=in, sel=sel[1], a=a, b=c);
    //DMux(in=in, sel=sel[1], a=b, b=d);
    // 00, tempA = in, tempB = 0, tempC = 0, tempD = 0
    // 01, tempA = 0, tempB = in, tempC = 0, tempD = in
    // 10, tempA = in, tempB = 0, tempC = in, tempD = 0
    // 11, tempA = 0, tempB = in, tempC = 0, tempD = in
}

