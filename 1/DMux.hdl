// by Nisan and Schocken, MIT Press.
/**
 * Demultiplexor:
 * [a, b] = [in, 0] if sel = 0
 *          [0, in] if sel = 1
 */
CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    Not(in=sel, out=notSel);
    And(a=notSel, b=true, out=selIsZero);
    And(a=selIsZero, b=in, out=a);
    And(a=sel, b=true, out=selIsOne);
    And(a=selIsOne, b=in, out=b);
}
