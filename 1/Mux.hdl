// by Nisan and Schocken, MIT Press.
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel, out=notSel);
    And(a=notSel, b=a, out=selIsZeroAndA);
    And(a=sel, b=b, out=selIsOneAndB);
    Or(a=selIsZeroAndA, b=selIsOneAndB, out=out);
}